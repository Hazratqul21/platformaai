# ============================================================
#  INNASOFT PLATFORMA — sozlamalar
#  Bu faylni `.env` deb nusxalang va to'ldiring.
#  Eng kamida BOT_TOKEN yetarli — qolgani standart qiymatda ishlaydi.
# ============================================================

# --- Telegram bot (mijozga smeta yuborish, "Qabul qildim" tugmasi) ---
# @BotFather dan olinadi. Bo'sh qoldirilsa — tizim faqat web rejimda
# ishlaydi, hech narsa buzilmaydi.
BOT_TOKEN=

# --- AI yordamchilar ---
# BITTASINI to'ldirsangiz yetarli — tizim kaliti bor provayderni o'zi
# tanlaydi. Hech biri bo'lmasa chat oynasi «kalit qo'yilmagan» deb
# yozadi, tizimning qolgan qismi normal ishlayveradi.

# Anthropic Claude — https://platform.claude.com
ANTHROPIC_API_KEY=

# OpenAI GPT — https://platform.openai.com
OPENAI_API_KEY=
# OpenAI-MOS boshqa xizmat (DeepSeek, Groq, Together, lokal Ollama...)
# ishlatilsa manzilini shu yerga yozing:
# OPENAI_BASE_URL=https://api.deepseek.com

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Bir nechta kalit bo'lsa qaysi biri ishlashini aniq belgilash:
# LLM_PROVAYDER=openai        (anthropic | openai | gemini)
# LLM_MODEL=gpt-5             (standart modelni almashtirish)

# --- Baza ---
# Docker Compose bilan ishlatsangiz bu qatorlarga tegmang.
POSTGRES_USER=innasoft
POSTGRES_PASSWORD=innasoft
POSTGRES_DB=innasoft
POSTGRES_PORT=5440

# Compose'siz, o'z PostgreSQL'ingizga ulanish:
# DATABASE_URL=postgresql://user:parol@host:5432/baza

# --- Web ---
APP_PORT=8070
# Frontend boshqa domenda bo'lsa: CORS_ORIGINS=https://erp.example.uz
CORS_ORIGINS=

# --- Birinchi ishga tushirish rejimi (bittasini tanlang) ---
# SEED_DEMO=1   demo ma'lumot bilan (tanishish uchun)
# SEED_EMPTY=1  bo'sh, faqat admin/1234 (haqiqiy ish uchun)
SEED_EMPTY=1
